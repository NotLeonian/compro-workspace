#!/usr/bin/env bash

_compro_vscode_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
source "$_compro_vscode_dir/compro-stack-limit.sh"
unset _compro_vscode_dir

if [[ "${1:-}" == "-c" ]]; then
	exec "${COMPRO_AUTOMATION_SHELL:-/bin/bash}" "$@"
fi

exec "${COMPRO_INTERACTIVE_SHELL:-${SHELL:-/bin/bash}}" "$@"
